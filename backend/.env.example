# Server
PORT=5001
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/chatly

# Auth - use a long, random value in production
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (image and voice note uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
